table activity_point_segments

	column activity_point_key
		dataType: string
		summarizeBy: none
		sourceColumn: activity_point_key

	column segment_effort_key
		dataType: int64
		summarizeBy: none
		sourceColumn: segment_effort_key

	column segment_key
		dataType: int64
		summarizeBy: none
		sourceColumn: segment_key

	partition activity_point_segments = m
		mode: import
		source =
			Parquet.Document(File.Contents(ExportFolder & "view_activity_point_segments.parquet"))
