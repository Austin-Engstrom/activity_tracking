				        {"Column", "gear", "distance_miles", "Source Strava lifetime equipment miles, rounded to 2 decimals; not restricted to GPS dataset history or report slicers.", null, "double", "#,0.00", null, false},
				        {"Column", "gear", "is_primary", "Is primary flag: 1 yes, 0 no; NULL unknown.", null, "int64", "0", null, false},
				        {"Column", "gear", "is_retired", "Is retired flag: 1 yes, 0 no; NULL unknown.", null, "int64", "0", null, false},
				        {"Column", "gear", "frame_type", "Strava frame-type code retained from source; consult source meaning before labeling.", null, "int64", "0", null, false},
				        {"Column", "gear", "detail_loaded_at", "Timestamp of the last equipment-detail load; NULL when detail is unavailable.", null, "dateTime", "yyyy-mm-dd hh:mm:ss", null, false},
				        {"Column", "gear", "created_at", "Source equipment row creation timestamp.", null, "dateTime", "yyyy-mm-dd hh:mm:ss", null, false},
				        {"Column", "gear", "updated_at", "Source equipment row last-update timestamp.", null, "dateTime", "yyyy-mm-dd hh:mm:ss", null, false},
				        {"Column", "gear_components", "component_key", "Stable component identifier linking gear_components, service events and current service status; do not sum.", null, "int64", "0", null, false},
				        {"Column", "gear_components", "gear_key", "Gear key; source identifier or relationship key, not a measure.", null, "string", null, null, true},
				        {"Column", "gear_components", "component_type", "Tracked component category, such as fork or chain.", null, "string", null, null, false},
				        {"Column", "gear_components", "manufacturer", "Component manufacturer as entered in the maintenance catalog.", null, "string", null, null, false},
				        {"Column", "gear_components", "model", "Component model as entered in the maintenance catalog.", null, "string", null, null, false},
				        {"Column", "gear_components", "installed_at", "Component installation timestamp; usage before installation is excluded.", null, "dateTime", "yyyy-mm-dd", null, false},
				        {"Column", "gear_components", "removed_at", "Component removal timestamp; NULL means currently installed. Usage after removal is excluded.", null, "dateTime", "yyyy-mm-dd", null, false},
				        {"Column", "gear_components", "service_interval_type", "Schedule unit: hours or miles. Determines which usage total drives status.", null, "string", null, null, false},
				        {"Column", "gear_components", "service_interval_value", "Scheduled interval in service_interval_type units; NULL means no complete schedule.", null, "double", "#,0.00", null, false},
				        {"Column", "gear_components", "notes", "User-entered notes for this component or service event at the table row grain.", null, "string", null, null, false},
				        {"Measure", "measures_", "Miles", "Sum of eligible GPS interval distance, in miles.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Excludes recording gaps and invalid intervals under the current reporting rules. Can differ from Strava's activity total.", "Distance", "Inferred by DAX", "#,0.00", "SUM(activity_points[incremental_distance_miles])", false},
				        {"Measure", "measures_", "Point Moving Hours", "Hours from eligible GPS intervals whose ending sample is marked moving.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Excludes invalid/gap intervals. This is point-derived moving time, not Strava's activity-summary moving time.", "Time", "Inferred by DAX", "#,0.00", "DIVIDE(SUM(activity_points[moving_time_seconds]),3600)", false},
				        {"Measure", "measures_", "Activities", "Distinct activities represented by the selected GPS points.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: An activity counts once even with many points. Only GPS-eligible activities are included; no mileage minimum is required.", "Activities", "Inferred by DAX", "#,0", "DISTINCTCOUNT(activity_points[activity_key])", false},
				        {"Measure", "measures_", "Miles in Selected Segments", "Miles from the union of GPS points linked to the selected segment efforts.#(lf)Filters: Follows segment selection and the current GPS point filters, including activity/date/trail selection.#(lf)Notes: Requires verified stream alignment. Overlapping segment rows may sum above the total because the total counts each linked point once. Interval mileage is assigned to its endpoint.", "Segments", "Inferred by DAX", "#,0.00", "CALCULATE([Miles], TREATAS(VALUES(activity_point_segments[activity_point_key]), activity_points[activity_point_key]))", false},
				        {"Measure", "measures_", "Whole Activity Miles", "Sum of full Strava activity-summary distances, in miles.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Not mileage allocated to the selected trail or day. Source-view rounding and GPS exclusions can explain differences from Miles.", "Activities", "Inferred by DAX", "#,0.00", "CALCULATE(SUM(activities[distance_miles]), TREATAS(VALUES(activity_points[activity_key]), activities[activity_key]))", false},
				        {"Measure", "measures_", "Moving Time", "Full Strava activity-summary moving time, in hours.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Not allocated to individual points or trails. Compare with Point Moving Hours to understand the two calculation grains.", "Time", "Inferred by DAX", "#,0.00", "CALCULATE(DIVIDE(SUM(activities[moving_time_minutes]),60), TREATAS(VALUES(activity_points[activity_key]), activities[activity_key]))", false},
				        {"Measure", "measures_", "GPS Points", "Count of GPS sample rows in the current selection.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Counts samples, not miles, activities or segment memberships. Recording frequency varies between activities.", "Validation", "Inferred by DAX", "#,0", "COUNTROWS(activity_points)", false},
				        {"Measure", "measures_", "Point Minus Activity Miles", "Miles minus Whole Activity Miles, in miles.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Negative means point mileage is lower. Partial route filters compare a route portion with full activity totals; a difference is not automatically an error.", "Validation", "Inferred by DAX", "#,0.00;−#,0.00;0.00", "[Miles] - [Whole Activity Miles]", false},
				        {"Measure", "measures_", "Point Minus Activity Moving Hours", "Point Moving Hours minus Activity Moving Hours.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Negative means point-derived hours are lower. Partial route filters and Strava processing can explain differences; this is not an automatic error flag.", "Validation", "Inferred by DAX", "#,0.00;−#,0.00;0.00", "[Point Moving Hours] - [Moving Time]", false},
				        {"Measure", "measures_", "UTC Fallback Points", "Count of selected GPS points dated using UTC because activity timezone metadata is missing.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Zero means no selected points are flagged as UTC fallback. It does not independently verify that supplied timezone metadata is correct.", "Validation", "Inferred by DAX", "#,0", "COALESCE(CALCULATE([GPS Points], KEEPFILTERS(activity_points[date_basis] = ""utc_fallback"")), 0)", false},
				        {"Measure", "measures_", "Recording Gap Intervals", "Count of selected GPS samples whose preceding interval is flagged as a recording gap.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: The rebuild threshold defaults to 60 seconds and can be configured. These interval distances/times are excluded from current point totals; missing data is not reconstructed.", "Validation", "Inferred by DAX", "#,0", "COALESCE(CALCULATE([GPS Points], KEEPFILTERS(activity_points[quality_status] = ""recording_gap"")), 0)", false},
				        {"Measure", "measures_", "Unmatched System Miles", "Eligible selected point mileage with no assigned trail-system key.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Can legitimately include roads and places outside mapped boundaries. This measures unassigned mileage, not total distance missing from GPS.", "Validation", "Inferred by DAX", "#,0.00", "CALCULATE([Miles], KEEPFILTERS(ISBLANK(activity_points[trail_system_key])))", false},
				        {"Measure", "measures_", "Unmatched Trail Miles", "Eligible selected point mileage with no confident trail assignment.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Includes ambiguous trails, points inside a system without a matched trail, and points outside mapped systems. Overlaps with Unmatched System Miles; do not add them together.", "Validation", "Inferred by DAX", "#,0.00", "CALCULATE([Miles], KEEPFILTERS(ISBLANK(activity_points[trail_key])))", false},
				        {"Measure", "measures_", "Segment Linked Points", "Distinct selected GPS points represented in verified segment-effort memberships.#(lf)Filters: Follows segment filters plus the current GPS point filters.#(lf)Notes: One point counts once even if linked to overlapping segments. Historical verification is partial; this count is not a percentage or an accuracy score.", "Validation", "Inferred by DAX", "#,0", "CALCULATE([GPS Points], TREATAS(VALUES(activity_point_segments[activity_point_key]), activity_points[activity_point_key]))", false},
				        {"Measure", "measures_", "Activity Time", "Full Strava activity-summary elapsed time, in hours.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Includes elapsed time rather than only movement. Partial point selections still include full activity durations.", "Time", "Inferred by DAX", "#,0.00", "CALCULATE(DIVIDE(SUM(activities[elapsed_time_minutes]), 60), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), activities[activity_key])))", false},
				        {"Measure", "measures_", "Elevation Gain", "Full Strava activity-summary elevation gain, in feet.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Uses ascent reported by Strava, not the sum of point elevations or elevation allocated to a trail.", "Elevation", "Inferred by DAX", "#,0", "CALCULATE(SUM(activities[total_elevation_gain_feet]), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), activities[activity_key])))", false},
				        {"Measure", "measures_", "Calories", "Sum of available Strava activity-summary calories.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Missing calories remain unknown. Totals may be incomplete when only some activities have calorie values.", "Activities", "Inferred by DAX", "#,0", "CALCULATE(SUM(activities[calories]), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), activities[activity_key])))", false},
				        {"Measure", "measures_", "Average Activity Miles", "Whole Activity Miles divided by the distinct selected activity count.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: This averages full activities, not point distances or selected trail portions.", "Activities", "Inferred by DAX", "#,0.00", "DIVIDE([Whole Activity Miles], [Activities])", false},
				        {"Measure", "measures_", "Average Moving Time", "Activity Moving Hours divided by the distinct selected activity count.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: This is the mean full-activity moving duration, in decimal hours.", "Time", "Inferred by DAX", "#,0.00", "DIVIDE([Moving Time], [Activities])", false},
				        {"Measure", "measures_", "Average Elevation Gain", "Activity Elevation Gain Feet divided by the distinct selected activity count.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: This is mean full-activity ascent in feet, not mean point altitude.", "Elevation", "Inferred by DAX", "#,0", "DIVIDE([Elevation Gain], [Activities])", false},
				        {"Measure", "measures_", "Average Speed", "Whole Activity Miles divided by Activity Moving Hours.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Uses aggregated distance and time rather than averaging activity speeds. Blank when the moving-hours denominator is zero.", "Performance", "Inferred by DAX", "#,0.00", "DIVIDE([Whole Activity Miles], [Moving Time])", false},
				        {"Measure", "measures_", "Elevation Feet per Mile", "Activity Elevation Gain Feet divided by Whole Activity Miles.#(lf)Filters: Uses each activity represented by the selected GPS points once. A partial trail or date selection includes that activity's full summary.#(lf)Notes: Both inputs use full activity summaries. Blank when the mileage denominator is zero.", "Performance", "Inferred by DAX", "#,0.00", "DIVIDE([Elevation Gain], [Whole Activity Miles])", false},
				        {"Measure", "measures_", "Activity Days", "Distinct nonblank reporting dates containing selected GPS points.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Dates are local when timezone metadata is available, otherwise UTC fallback. An activity spanning midnight can contribute to multiple days; no qualifying rows can display blank.", "Activities", "Inferred by DAX", "#,0", "DISTINCTCOUNTNOBLANK(activity_points[date_key])", false},
				        {"Measure", "measures_", "Point Miles per Activity", "Selected point mileage divided by the distinct selected activity count.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: A partial trail selection uses only its point mileage. An activity counts once; a zero activity denominator returns blank.", "Distance", "Inferred by DAX", "#,0.00", "DIVIDE([Miles], [Activities])", false},
				        {"Measure", "measures_", "Segment Efforts", "Count of Strava segment effort records in the selected scope.#(lf)Filters: Follows segment filters and includes whole efforts from point-selected activities. A partial route/date selection does not trim the effort.#(lf)Notes: Repeated traversals count as separate efforts. Does not require verified GPS-point memberships.", "Segments", "Inferred by DAX", "#,0", "CALCULATE(COUNTROWS(segment_efforts), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), segment_efforts[activity_key])))", false},
				        {"Measure", "measures_", "Segment Miles", "Sum of Strava segment-effort distances, in miles.#(lf)Filters: Follows segment filters and includes whole efforts from point-selected activities. A partial route/date selection does not trim the effort.#(lf)Notes: Repeated and overlapping efforts are additive. This can exceed the activity distance; use Miles in Selected Segments for linked-point union mileage.", "Segments", "Inferred by DAX", "#,0.00", "CALCULATE(SUM(segment_efforts[distance_miles]), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), segment_efforts[activity_key])))", false},
				        {"Measure", "measures_", "Segment Effort Moving Hours", "Sum of full Strava segment-effort moving times, in hours.#(lf)Filters: Follows segment filters and includes whole efforts from point-selected activities. A partial route/date selection does not trim the effort.#(lf)Notes: Repeated and overlapping efforts can count the same activity time more than once. Does not require verified point memberships.", "Segments", "Inferred by DAX", "#,0.00", "CALCULATE(DIVIDE(SUM(segment_efforts[moving_time_seconds]), 3600), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), segment_efforts[activity_key])))", false},
				        {"Measure", "measures_", "Segments Ridden", "Distinct Strava segment keys with efforts in the selected scope.#(lf)Filters: Follows segment filters and includes whole efforts from point-selected activities. A partial route/date selection does not trim the effort.#(lf)Notes: Repeated efforts on the same segment count once. Includes GPS activities of all sport types and does not require verified point memberships.", "Segments", "Inferred by DAX", "#,0", "CALCULATE(DISTINCTCOUNTNOBLANK(segment_efforts[segment_key]), KEEPFILTERS(TREATAS(VALUES(activity_points[activity_key]), segment_efforts[activity_key])))", false},
				        {"Measure", "measures_", "Linked Segment Effort Count", "Count of distinct verified segment efforts touching selected GPS points.#(lf)Filters: Follows segment selection and the actual selected point subset, including partial trail/date filters.#(lf)Notes: Unlike Segment Effort Count, requires verified point memberships. An effort touching several selected points still counts once.", "Segments", "Inferred by DAX", "#,0", "VAR SelectedEfforts =#(lf)    CALCULATETABLE(#(lf)        VALUES(activity_point_segments[segment_effort_key]),#(lf)        KEEPFILTERS(TREATAS(VALUES(activity_points[activity_point_key]), activity_point_segments[activity_point_key]))#(lf)    )#(lf)RETURN#(lf)    CALCULATE(#(lf)        COUNTROWS(segment_efforts),#(lf)        KEEPFILTERS(TREATAS(SelectedEfforts, segment_efforts[segment_effort_key]))#(lf)    )", false},
				        {"Measure", "measures_", "Matched Trail Activities", "Distinct activities with at least one selected point assigned to a trail.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: The same activity may appear under several trails, so trail-row counts are not additive.", "Trails", "Inferred by DAX", "#,0", "CALCULATE([Activities], KEEPFILTERS(NOT ISBLANK(activity_points[trail_key])))", false},
				        {"Measure", "measures_", "Matched Trail Miles", "Eligible selected point mileage confidently assigned to a trail.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Excludes ambiguous/unmatched trails. This is traveled mileage, not unique geographic coverage or a completion measure.", "Trails", "Inferred by DAX", "#,0.00", "CALCULATE([Miles], KEEPFILTERS(NOT ISBLANK(activity_points[trail_key])))", false},
				        {"Measure", "measures_", "Trails Visited", "Distinct nonblank trail keys represented by selected GPS points.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Counts any point assignment, even without positive interval mileage. Repeated visits count once; includes all GPS sport types.", "Trails", "Inferred by DAX", "#,0", "DISTINCTCOUNTNOBLANK(activity_points[trail_key])", false},
				        {"Measure", "measures_", "Visited Trail Length Miles", "Full mapped lengths of the distinct trails touched by selected points.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Each touched trail contributes its whole catalog length once. Does not measure traveled distance, unique distance covered or completion.", "Trails", "Inferred by DAX", "#,0.00", "CALCULATE(#(lf)    SUM(trails[length_miles]),#(lf)    KEEPFILTERS(TREATAS(VALUES(activity_points[trail_key]), trails[trail_key]))#(lf))", false},
				        {"Measure", "measures_", "Matched System Miles", "Eligible selected point mileage assigned to mapped trail systems.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Uses existing confirmed boundaries. Does not imply that every point has an individual trail match.", "Trail Systems", "Inferred by DAX", "#,0.00", "CALCULATE([Miles], KEEPFILTERS(NOT ISBLANK(activity_points[trail_system_key])))", false},
				        {"Measure", "measures_", "Trail Systems Visited", "Distinct nonblank trail-system keys represented by selected GPS points.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: A point assignment is sufficient; repeat visits count once. Systems without mapped boundaries cannot be discovered by this measure.", "Trail Systems", "Inferred by DAX", "#,0", "DISTINCTCOUNTNOBLANK(activity_points[trail_system_key])", false},
				        {"Measure", "measures_", "Trail Match %", "Matched Trail Miles divided by Miles.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Reports assignment coverage within the current selection, not trail completion or matching accuracy. Blank when selected eligible mileage is zero.", "Validation", "Inferred by DAX", "0.0%", "DIVIDE([Matched Trail Miles], [Miles])", false},
				        {"Measure", "measures_", "System Match %", "Matched System Miles divided by Miles.#(lf)Filters: Follows the selected GPS points, including date, activity, gear, sport, trail and system filters. A segment selection alone does not filter this measure.#(lf)Notes: Reports assignment coverage, not system completion. Unmapped riding locations are expected gaps; blank when mileage is zero.", "Validation", "Inferred by DAX", "0.0%", "DIVIDE([Matched System Miles], [Miles])", false},
				        {"Measure", "measures_", "Service Interval Remaining %", "Remaining scheduled service interval as a ratio, floored at zero. Uses the single distinct current component-status value in context; returns blank when multiple different values are selected. Follows gear/component filters; activity-date and GPS-route filters do not recompute the exported status.", "Maintenance", "Inferred by DAX", "0.0%", "SELECTEDVALUE(component_service_status[service_interval_remaining_percent])", false},
				        {"Measure", "measures_", "Service Interval Remaining", "Remaining scheduled hours or miles, floored at zero. Uses the single distinct current component-status value in context; returns blank for multiple different values. Read with Service Interval Unit; this is the exported maintenance snapshot, not date-selected GPS usage.", "Maintenance", "Inferred by DAX", "#,0.0", "SELECTEDVALUE(component_service_status[service_interval_remaining])", false},
				        {"Measure", "measures_", "Service Interval Unit", "Schedule unit (hours or miles) when one distinct unit is selected; otherwise blank. Follows the current gear/component status context.", "Maintenance", "Inferred by DAX", null, "SELECTEDVALUE(component_service_status[service_interval_type])", false},
				        {"Measure", "measures_", "Next Service Remaining", "Formatted remaining interval plus schedule unit, using the remaining-value and unit measures. Blank when remaining usage is ambiguous or absent; values describe the exported maintenance snapshot.", "Maintenance", "Inferred by DAX", null, "VAR Remaining = [Service Interval Remaining]#(lf)VAR Unit = [Service Interval Unit]#(lf)RETURN IF(NOT ISBLANK(Remaining), FORMAT(Remaining, ""#,0.0"") & "" "" & Unit)", false},
				        {"Measure", "measures_", "Segments Associated", "Count of observed segment-trail-system combinations in the association bridge.#(lf)Filters: Follows segment, trail and system dimension filters across all verified history. Filters from activities, dates, gear and activity_types do not restrict this catalog.#(lf)Notes: Despite the name, this is not a distinct segment count. One segment can contribute multiple combinations, including system-only or point-only evidence.", "Segments\Associations", "Inferred by DAX", "#,0", "COUNTROWS(segment_trail_associations)", false},
				        {"Measure", "measures_", "Associated Trails", "Distinct nonblank trail keys in the selected segment associations.#(lf)Filters: Follows segment, trail and system dimension filters across all verified history. Filters from activities, dates, gear and activity_types do not restrict this catalog.#(lf)Notes: System-only rows do not add a trail. Associations are observations from verified GPS history, not manually confirmed geographic ownership.", "Segments\Associations", "Inferred by DAX", "#,0", "DISTINCTCOUNTNOBLANK(segment_trail_associations[trail_key])", false},
				        {"Measure", "measures_", "Associated Trail Systems", "Distinct nonblank system keys in the selected segment associations.#(lf)Filters: Follows segment, trail and system dimension filters across all verified history. Filters from activities, dates, gear and activity_types do not restrict this catalog.#(lf)Notes: Includes system-only associations without a named trail. Verification and mapped geometry limit coverage.", "Segments\Associations", "Inferred by DAX", "#,0", "DISTINCTCOUNTNOBLANK(segment_trail_associations[trail_system_key])", false},
				        {"Measure", "measures_", "Observed Segment Association Miles", "Sum of eligible observed interval miles per associated segment effort.#(lf)Filters: Follows segment, trail and system dimension filters across all verified history. Filters from activities, dates, gear and activity_types do not restrict this catalog.#(lf)Notes: Repeated and overlapping efforts are additive. Excludes intervals ending at effort start indexes; not unique segment length or a confidence score.", "Segments\Associations", "Inferred by DAX", "#,0.00", "SUM(segment_trail_associations[observed_distance_miles])", false},
				        {"Measure", "measures_", "Weeks in Selection", "Number of Monday-Sunday weeks touched by the selected modeled calendar dates.#(lf)Filters: Follows date-dimension filters; activity, gear and trail filters do not reduce the calendar denominator.#(lf)Notes: Includes inactive and partial boundary weeks. Dates outside the modeled calendar are not counted.", "Consistency\Weeks", "Inferred by DAX", "#,0", "COALESCE(COUNTROWS(FILTER(VALUES(dates[week_start_date]), NOT ISBLANK(dates[week_start_date]))), 0)", false},
				        {"Measure", "measures_", "Active Weeks", "Number of selected Monday-Sunday weeks containing at least one qualifying GPS point.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Only points on dates actually selected qualify. A partial week counts once; activity crossing a week boundary can activate both weeks.", "Consistency\Weeks", "Inferred by DAX", "#,0", "COALESCE(COUNTROWS(#(lf)    FILTER(#(lf)        VALUES(dates[week_start_date]),#(lf)        NOT ISBLANK(dates[week_start_date]) && CALCULATE([Activities]) > 0#(lf)    )#(lf)), 0)", false},
				        {"Measure", "measures_", "Inactive Weeks", "Weeks in Selection minus Active Weeks.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: No qualifying selected GPS activity means inactive for this dataset; indoor/non-GPS activities and missing history do not make a week active.", "Consistency\Weeks", "Inferred by DAX", "#,0", "[Weeks in Selection] - [Active Weeks]", false},
				        {"Measure", "measures_", "Active Week %", "Active Weeks divided by Weeks in Selection.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Inactive and partial boundary weeks are included in the calendar denominator. Blank when no modeled weeks are selected.", "Consistency\Weeks", "Inferred by DAX", "0.0%", "DIVIDE([Active Weeks], [Weeks in Selection])", false},
				        {"Measure", "measures_", "Active Days per Week", "Active reporting dates divided by all selected calendar weeks.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Includes inactive weeks as zero-active-day weeks. On a single week row, shows the selected active-day count; partial weeks are not prorated.", "Consistency\Weeks", "Inferred by DAX", "0.00", "DIVIDE(COALESCE([Activity Days], 0), [Weeks in Selection])", false},
				        {"Measure", "measures_", "Active Days per Active Week", "Active reporting dates divided by active weeks only.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Excludes inactive weeks from the average. Blank when no active weeks qualify.", "Consistency\Weeks", "Inferred by DAX", "0.00", "DIVIDE([Activity Days], [Active Weeks])", false},
				        {"Measure", "measures_", "Activities per Week", "Distinct selected activities divided by active weeks.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: An activity spanning weeks counts once in the activity numerator. Blank when no active weeks qualify.", "Consistency\Weeks", "Inferred by DAX", "0.00", "DIVIDE([Activities], [Active Weeks])", false},
				        {"Measure", "measures_", "Longest Active Week Streak", "Longest consecutive run of active Monday-Sunday weeks within the current date selection.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Uses actual week-start dates, so streaks cross New Year. Inactive or omitted whole weeks break a streak; partial boundary weeks can qualify. Returns zero when none qualify.", "Consistency\Weeks", "Inferred by DAX", "#,0", "VAR ActiveWeeks =#(lf)    FILTER(#(lf)        VALUES(dates[week_start_date]),#(lf)        NOT ISBLANK(dates[week_start_date]) && CALCULATE([Activities]) > 0#(lf)    )#(lf)VAR WeekGroups =#(lf)    ADDCOLUMNS(#(lf)        ActiveWeeks,#(lf)        ""__WeekGroup"",#(lf)            INT(DIVIDE(dates[week_start_date] - DATE(1900, 1, 1), 7))#(lf)                - RANKX(ActiveWeeks, dates[week_start_date], , ASC, DENSE)#(lf)    )#(lf)RETURN#(lf)    COALESCE(#(lf)        MAXX(#(lf)            WeekGroups,#(lf)            VAR CurrentGroup = [__WeekGroup]#(lf)            RETURN COUNTROWS(FILTER(WeekGroups, [__WeekGroup] = CurrentGroup))#(lf)        ),#(lf)        0#(lf)    )", false},
				        {"Measure", "measures_", "Longest Active Week Streak All Dates", "Longest consecutive active-week run across the modeled date history.#(lf)Filters: Removes all date-dimension filters, including the date slicer; retains other filters such as activity, gear, sport and trail.#(lf)Notes: Not an unfiltered personal lifetime record when other filters remain. Missing/non-GPS history is not inferred; returns zero when none qualify.", "Consistency\Weeks", "Inferred by DAX", "#,0", "CALCULATE([Longest Active Week Streak], REMOVEFILTERS(dates))", false},
				        {"Measure", "measures_", "Active Days", "Count of selected nonblank reporting dates with qualifying GPS points.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Reuses Activity Days, displaying zero rather than blank when none qualify. Local dates use timezone metadata, otherwise UTC fallback.", "Consistency\Days", "Inferred by DAX", "#,0", "COALESCE([Activity Days], 0)", false},
				        {"Measure", "measures_", "Days in Selection", "Number of distinct selected modeled calendar dates.#(lf)Filters: Follows date-dimension filters; activity, gear and trail filters do not reduce this calendar denominator.#(lf)Notes: Includes dates without activity. Does not count dates outside the modeled calendar; returns zero for an empty date selection.", "Consistency\Days", "Inferred by DAX", "#,0", "COALESCE(COUNTROWS(FILTER(VALUES(dates[date]), NOT ISBLANK(dates[date]))), 0)", false},
				        {"Measure", "measures_", "Inactive Days", "Days in Selection minus Active Days.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Describes absence of qualifying selected GPS points, not absence of all exercise. Indoor/non-GPS activities are outside this dataset.", "Consistency\Days", "Inferred by DAX", "#,0", "[Days in Selection] - [Active Days]", false},
				        {"Measure", "measures_", "Active Day %", "Active Days divided by Days in Selection.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Includes inactive modeled dates in the denominator. Blank when no modeled dates are selected.", "Consistency\Days", "Inferred by DAX", "0.0%", "DIVIDE([Active Days], [Days in Selection])", false},
				        {"Measure", "measures_", "Activities per Day", "Distinct selected activities divided by active reporting dates.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: A multi-day activity contributes once to the activity numerator but may activate several dates. Blank when no active dates qualify.", "Consistency\Days", "Inferred by DAX", "0.00", "DIVIDE([Activities], [Active Days])", false},
				        {"Measure", "measures_", "Point Miles per Active Day", "Eligible selected point miles divided by active reporting dates.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Uses point mileage, including only selected route portions. Blank when no active dates qualify.", "Consistency\Days", "Inferred by DAX", "0.00", "DIVIDE([Miles], [Active Days])", false},
				        {"Measure", "measures_", "Point Moving Hours per Active Day", "Eligible selected point moving hours divided by active reporting dates.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Uses point-derived movement, not full Strava activity summaries. Blank when no active dates qualify.", "Consistency\Days", "Inferred by DAX", "0.00", "DIVIDE([Point Moving Hours], [Active Days])", false},
				        {"Measure", "measures_", "Longest Active Day Streak", "Longest run of consecutive active local reporting dates within the selection.#(lf)Filters: Follows the selected reporting dates and other GPS-point filters. Segment-only filters do not apply.#(lf)Notes: Inactive dates or omitted dates in disjoint selections break the streak. Crosses month/year/leap-day boundaries; returns zero when no dates qualify.", "Consistency\Days", "Inferred by DAX", "#,0", "VAR ActiveDates =#(lf)    FILTER(#(lf)        VALUES(dates[date]),#(lf)        NOT ISBLANK(dates[date]) && CALCULATE([Activities]) > 0#(lf)    )#(lf)VAR DayGroups =#(lf)    ADDCOLUMNS(#(lf)        ActiveDates,#(lf)        ""__DayGroup"",#(lf)            INT(dates[date]) - RANKX(ActiveDates, dates[date], , ASC, DENSE)#(lf)    )#(lf)RETURN#(lf)    COALESCE(#(lf)        MAXX(#(lf)            DayGroups,#(lf)            VAR CurrentGroup = [__DayGroup]#(lf)            RETURN COUNTROWS(FILTER(DayGroups, [__DayGroup] = CurrentGroup))#(lf)        ),#(lf)        0#(lf)    )", false},
				        {"Measure", "measures_", "Longest Active Day Streak All Dates", "Longest consecutive active-day run across the modeled date history.#(lf)Filters: Removes date-dimension filters, including the date slicer; retains other filters such as activity, gear, sport and trail.#(lf)Notes: Does not infer dates outside available history or activity without GPS. Not necessarily a personal lifetime record under other filters.", "Consistency\Days", "Inferred by DAX", "#,0", "CALCULATE([Longest Active Day Streak], REMOVEFILTERS(dates))", false},
