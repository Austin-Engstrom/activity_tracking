table measures_

	measure 'Miles Ridden' = SUM(activity_points[incremental_distance_miles])
		formatString: #,0.00
		displayFolder: Distance

	measure 'Point Moving Hours' = DIVIDE(SUM(activity_points[moving_time_seconds]),3600)
		formatString: #,0.00
		displayFolder: Time

	measure 'Activities Ridden' = DISTINCTCOUNT(activity_points[activity_key])
		formatString: #,0
		displayFolder: Activities

	measure 'Miles in Selected Segments' = CALCULATE([Miles Ridden], TREATAS(VALUES(activity_point_segments[activity_point_key]), activity_points[activity_point_key]))
		formatString: #,0.00
		displayFolder: Segments

	measure 'Whole Activity Miles' = CALCULATE(SUM(activities[distance_miles]), TREATAS(VALUES(activity_points[activity_key]), activities[activity_key]))
		formatString: #,0.00
		displayFolder: Activities

	measure 'Activity Moving Hours' = CALCULATE(DIVIDE(SUM(activities[moving_time_minutes]),60), TREATAS(VALUES(activity_points[activity_key]), activities[activity_key]))
		formatString: #,0.00
		displayFolder: Time

	measure 'GPS Points' = COUNTROWS(activity_points)
		formatString: #,0
		displayFolder: Validation

	measure 'Point Minus Activity Miles' = [Miles Ridden] - [Whole Activity Miles]
		formatString: #,0.00;−#,0.00;0.00
		displayFolder: Validation

	measure 'Point Minus Activity Moving Hours' = [Point Moving Hours] - [Activity Moving Hours]
		formatString: #,0.00;−#,0.00;0.00
		displayFolder: Validation

	measure 'UTC Fallback Points' = COALESCE(CALCULATE([GPS Points], KEEPFILTERS(activity_points[date_basis] = "utc_fallback")), 0)
		formatString: #,0
		displayFolder: Validation

	measure 'Recording Gap Intervals' = COALESCE(CALCULATE([GPS Points], KEEPFILTERS(activity_points[quality_status] = "recording_gap")), 0)
		formatString: #,0
		displayFolder: Validation

	measure 'Unmatched System Miles' = CALCULATE([Miles Ridden], KEEPFILTERS(ISBLANK(activity_points[trail_system_key])))
		formatString: #,0.00
		displayFolder: Validation

	measure 'Unmatched Trail Miles' = CALCULATE([Miles Ridden], KEEPFILTERS(ISBLANK(activity_points[trail_key])))
		formatString: #,0.00
		displayFolder: Validation

	measure 'Segment Linked Points' = CALCULATE([GPS Points], TREATAS(VALUES(activity_point_segments[activity_point_key]), activity_points[activity_point_key]))
		formatString: #,0
		displayFolder: Validation

	column Placeholder
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition measures_ = calculated
		mode: import
		source = ROW("Placeholder", 0)
