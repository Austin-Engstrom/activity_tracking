table component_services
	lineageTag: c90b7790-465c-4133-aac4-95a07b52b444

	/// Unique maintenance service-event identifier; do not sum.
	column service_id
		dataType: int64
		formatString: 0
		lineageTag: 2f12cf80-6e9a-4b17-a9c1-bffe8424e63d
		summarizeBy: none
		sourceColumn: service_id

		annotation SummarizationSetBy = User

	/// Stable component identifier linking gear_components, service events and current service status; do not sum.
	column component_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 15d9a09d-bf08-4d90-969f-f9cfd5b3464b
		summarizeBy: none
		sourceColumn: component_key

		annotation SummarizationSetBy = User

	/// Recorded date/timestamp of this maintenance event.
	column service_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ce5005b0-8083-4bc3-b5f5-fe6129e39493
		summarizeBy: none
		sourceColumn: service_date

	/// User-entered maintenance service category.
	column service_type
		dataType: string
		lineageTag: ec7b7113-79d5-4cc5-bf0d-533b953fe894
		summarizeBy: none
		sourceColumn: service_type

	/// User-entered notes for this component or service event at the table row grain.
	column notes
		dataType: string
		lineageTag: a18faa7a-c7f1-49f9-bf87-f7aad76a97be
		summarizeBy: none
		sourceColumn: notes

	partition component_services = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "view_component_services.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"service_id", Int64.Type}, {"component_key", Int64.Type}, {"service_date", type datetime}, {"service_type", type text}, {"notes", type text}})
				in
				    Typed
