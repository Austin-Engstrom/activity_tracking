table gear

	column gear_key
		dataType: string
		summarizeBy: none
		sourceColumn: gear_key

	column gear_id
		dataType: string
		summarizeBy: none
		sourceColumn: gear_id

	column athlete_id
		dataType: int64
		summarizeBy: none
		sourceColumn: athlete_id

	column gear_name
		dataType: string
		summarizeBy: none
		sourceColumn: gear_name

	column brand_name
		dataType: string
		summarizeBy: none
		sourceColumn: brand_name

	column model_name
		dataType: string
		summarizeBy: none
		sourceColumn: model_name

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column distance_miles
		dataType: double
		summarizeBy: none
		sourceColumn: distance_miles

	column is_primary
		dataType: int64
		summarizeBy: none
		sourceColumn: is_primary

	column is_retired
		dataType: int64
		summarizeBy: none
		sourceColumn: is_retired

	column frame_type
		dataType: int64
		summarizeBy: none
		sourceColumn: frame_type

	column detail_loaded_at
		dataType: dateTime
		summarizeBy: none
		sourceColumn: detail_loaded_at

	column created_at
		dataType: dateTime
		summarizeBy: none
		sourceColumn: created_at

	column updated_at
		dataType: dateTime
		summarizeBy: none
		sourceColumn: updated_at

	partition gear = m
		mode: import
		source =
			Parquet.Document(File.Contents(ExportFolder & "view_gear.parquet"))
