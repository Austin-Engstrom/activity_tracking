/// Field parameter for choosing explicit measures in visuals. Each selection uses the original measure calculation and format.
table select_measures
	lineageTag: bb13c759-5aa4-4cad-9cd5-681f6e08c7d3

	/// Slicer choices and dynamic visual field. Uses field-parameter metadata on the hidden fields column.
	column selection
		dataType: string
		lineageTag: c5e8e473-0bf9-43a3-b5e8-666c55c1e14d
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: sort_order

		relatedColumnDetails
			groupByColumn: fields

	/// Fully qualified model field reference used by Power BI to expand the parameter.
	column fields
		dataType: string
		isHidden
		lineageTag: ae861f97-b09d-442b-9842-fc28ae757088
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: sort_order

		extendedProperty ParameterMetadata =
			{
			  "version": 3,
			  "kind": 2
			}

	/// Stable display order for parameter choices.
	column sort_order
		dataType: int64
		isHidden
		lineageTag: 0c0a9949-7cd9-4401-ba5f-ed5030c00f14
		summarizeBy: none
		sourceColumn: [Value3]

