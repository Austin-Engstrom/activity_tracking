table dates
	lineageTag: dd921200-6387-4dbe-9a46-9535174b3112

	/// Modeled calendar date spanning earliest through latest point date, including inactive dates.
	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 136976a6-30d2-417e-9050-ae2ef637f249
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	/// YYYYMMDD point-local calendar key (UTC when timezone metadata is missing).
	column date_key
		dataType: int64
		formatString: 0
		lineageTag: be2b8751-5ef8-447e-9626-dea22a8a897c
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = User

	/// SQLite numbering: Sunday=0 through Saturday=6.
	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: d8092ed3-6603-4889-b835-bfd302e73f43
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = User

	/// Calendar month number, January=1 through December=12.
	column month_number
		dataType: int64
		formatString: 0
		lineageTag: 0887a49d-ba11-4ff3-9f4e-e6678c46b6b3
		summarizeBy: none
		sourceColumn: month_number

		annotation SummarizationSetBy = User

	/// Calendar quarter number, 1 through 4.
	column quarter_number
		dataType: int64
		formatString: 0
		lineageTag: 81aaa940-1a2a-4227-aaf5-40b3bbad69a9
		summarizeBy: none
		sourceColumn: quarter_number

		annotation SummarizationSetBy = User

	/// Sunday of the containing local calendar week.
	column week_end_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 5e5f0a7a-43b3-437f-be0b-d1b953ff3b57
		summarizeBy: none
		sourceColumn: week_end_date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	/// SQLite %W: Monday-based week 00–53; use week_start_date across years.
	column week_number
		dataType: int64
		formatString: 0
		lineageTag: 6121865d-ada9-4803-be84-2a458da4ba00
		summarizeBy: none
		sourceColumn: week_number

		annotation SummarizationSetBy = User

	/// Monday of the containing local calendar week.
	column week_start_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: bad23327-c897-4f62-8608-2bbc14117895
		summarizeBy: none
		sourceColumn: week_start_date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	/// Calendar year of the modeled point date.
	column year
		dataType: int64
		formatString: 0
		lineageTag: 0bef317e-e229-4256-a041-e2cee69b83ad
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	/// English calendar month name for the local reporting date, sorted chronologically by month_number. Use year above this level to distinguish history across years.
	column month_name = FORMAT(dates[date], "MMMM", "en-US")
		dataType: string
		lineageTag: 50b64e07-8a64-40b6-8ba8-f03632fabe57
		summarizeBy: none
		sortByColumn: month_number

	partition dates = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "view_date.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"date", type datetime}, {"date_key", Int64.Type}, {"day_of_week", Int64.Type}, {"month_number", Int64.Type}, {"quarter_number", Int64.Type}, {"week_end_date", type datetime}, {"week_number", Int64.Type}, {"week_start_date", type datetime}, {"year", Int64.Type}})
				in
				    Typed
