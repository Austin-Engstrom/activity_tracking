table dates

	column date_key
		dataType: int64
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		summarizeBy: none
		sourceColumn: month_number

	column quarter_number
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter_number

	column week_number
		dataType: int64
		summarizeBy: none
		sourceColumn: week_number

	column day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week

	partition dates = m
		mode: import
		source =
			let
			    Source = Parquet.Document(File.Contents(ExportFolder & "view_date.parquet")),
			    Typed = Table.TransformColumnTypes(Source, {{"date_key", Int64.Type}, {"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"quarter_number", Int64.Type}, {"week_number", Int64.Type}, {"day_of_week", Int64.Type}})
			in
			    Typed
