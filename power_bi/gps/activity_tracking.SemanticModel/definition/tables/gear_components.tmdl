table gear_components
	lineageTag: 870ffdbd-96f4-4f72-aa9e-60edf119e136

	/// Stable component identifier linking gear_components, service events and current service status; do not sum.
	column component_key
		dataType: int64
		formatString: 0
		lineageTag: e67f17ea-2d4b-4852-af3f-22a2501874d3
		summarizeBy: none
		sourceColumn: component_key

		annotation SummarizationSetBy = User

	/// Gear key; source identifier or relationship key, not a measure.
	column gear_key
		dataType: string
		isHidden
		lineageTag: fc03b202-29c7-43bf-8910-a7cd0e8c2106
		summarizeBy: none
		sourceColumn: gear_key

		annotation SummarizationSetBy = User

	/// Tracked component category, such as fork or chain.
	column component_type
		dataType: string
		lineageTag: f9628507-d979-49e7-940e-76779a25d0f8
		summarizeBy: none
		sourceColumn: component_type

	/// Component manufacturer as entered in the maintenance catalog.
	column manufacturer
		dataType: string
		lineageTag: 55f8c00e-1b99-41fc-b751-f073d9fcc35d
		summarizeBy: none
		sourceColumn: manufacturer

	/// Component model as entered in the maintenance catalog.
	column model
		dataType: string
		lineageTag: 987c2af2-0680-4b3d-8a7d-c2707a512d1a
		summarizeBy: none
		sourceColumn: model

	/// Component installation timestamp; usage before installation is excluded.
	column installed_at
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 2208f000-70e5-482b-92e5-0f1a122c6944
		summarizeBy: none
		sourceColumn: installed_at

	/// Component removal timestamp; NULL means currently installed. Usage after removal is excluded.
	column removed_at
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 43be7bd8-8bab-4c46-972c-cb563854d11c
		summarizeBy: none
		sourceColumn: removed_at

	/// Schedule unit: hours or miles. Determines which usage total drives status.
	column service_interval_type
		dataType: string
		lineageTag: d4312b22-9c05-4e31-8cb8-648ef251545a
		summarizeBy: none
		sourceColumn: service_interval_type

	/// Scheduled interval in service_interval_type units; NULL means no complete schedule.
	column service_interval_value
		dataType: double
		formatString: #,0.00
		lineageTag: bab65cdc-fc57-49b4-be45-2ad384b12257
		summarizeBy: none
		sourceColumn: service_interval_value

	/// User-entered notes for this component or service event at the table row grain.
	column notes
		dataType: string
		lineageTag: 417a6cf8-0018-4d59-8471-7dbec71feb20
		summarizeBy: none
		sourceColumn: notes

	partition gear_components = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "view_gear_components.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"component_key", Int64.Type}, {"gear_key", type text}, {"component_type", type text}, {"manufacturer", type text}, {"model", type text}, {"installed_at", type datetime}, {"removed_at", type datetime}, {"service_interval_type", type text}, {"service_interval_value", type number}, {"notes", type text}})
				in
				    Typed
