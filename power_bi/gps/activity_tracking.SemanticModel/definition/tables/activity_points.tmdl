		summarizeBy: none
		sourceColumn: timezone_name

	/// Latitude snapped to 0.00025-degree heatmap cells (about 28 metres north/south, longitude-dependent east/west). Weight by Activities to count each distinct activity once per cell; repeated samples within one activity do not increase its weight.
	column map_latitude = IF(NOT ISBLANK(activity_points[latitude]), ROUND(activity_points[latitude] * 4000, 0) / 4000, BLANK())
		dataType: double
		lineageTag: 6244a6a3-a64f-4291-9bd8-8fd3b181e2ea
		formatString: 0.000
		dataCategory: Latitude
		summarizeBy: none

	/// Longitude snapped to 0.00025-degree heatmap cells (about 28 metres north/south, longitude-dependent east/west). Weight by Activities to count each distinct activity once per cell; repeated samples within one activity do not increase its weight.
	column map_longitude = IF(NOT ISBLANK(activity_points[longitude]), ROUND(activity_points[longitude] * 4000, 0) / 4000, BLANK())
		dataType: double
		lineageTag: d5ae49ef-832f-4ce5-bfe6-5b45b10cafdb
		formatString: 0.000
		dataCategory: Longitude
		summarizeBy: none

	partition activity_points = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "view_activity_points.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"activity_id", Int64.Type}, {"activity_key", Int64.Type}, {"activity_point_key", type text}, {"activity_type_key", type text}, {"cadence", type number}, {"cumulative_distance_miles", type number}, {"date_basis", type text}, {"date_key", Int64.Type}, {"elapsed_time_seconds", type number}, {"elevation_feet", type number}, {"gear_key", type text}, {"grade_percent", type number}, {"heartrate", type number}, {"incremental_distance_miles", type number}, {"incremental_time_seconds", type number}, {"is_moving", Int64.Type}, {"latitude", type number}, {"longitude", type number}, {"match_method", type text}, {"moving_time_seconds", type number}, {"point_index", Int64.Type}, {"quality_status", type text}, {"recorded_at_utc", type datetime}, {"speed_mph", type number}, {"temperature_f", type number}, {"trail_key", Int64.Type}, {"trail_system_key", Int64.Type}, {"watts", type number}, {"recorded_at", type datetime}, {"timezone_name", type text}}),
				    Renamed = Table.RenameColumns(Typed, {{"cumulative_distance_miles", "cumulative_distance"}, {"elapsed_time_seconds", "elapsed_time"}, {"incremental_distance_miles", "incremental_distance"}, {"incremental_time_seconds", "incremental_time"}, {"moving_time_seconds", "moving_time"}})
				in
				    Renamed
